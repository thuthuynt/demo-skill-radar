<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chạy crawler mỗi ngày 07:00. Máy ngủ lúc 07:00 thì launchd chạy bù khi máy thức;
     máy TẮT hẳn thì không chạy bù. caffeinate giữ máy không ngủ trong lúc crawl. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ducklytics.skillradar.crawl</string>
  <key>WorkingDirectory</key>
  <string>/Users/thuy.tnguyen/Documents/GitHub/demo-skill-radar/skillradar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/thuy.tnguyen/Documents/GitHub/demo-skill-radar/skillradar/.venv/bin/python</string>
    <string>-m</string>
    <string>src.crawl.run</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/thuy.tnguyen/Documents/GitHub/demo-skill-radar/skillradar/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/thuy.tnguyen/Documents/GitHub/demo-skill-radar/skillradar/logs/launchd.err</string>
</dict>
</plist>
